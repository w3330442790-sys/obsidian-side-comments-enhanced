{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2020",
    "jsx": "react-jsx",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "Bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "vendor/personal-mindmap/src/**/*.ts",
    "vendor/personal-mindmap/vendor/gogoga/src/**/*.ts",
    "vendor/personal-mindmap/webview/src/**/*.ts",
    "vendor/personal-mindmap/webview/src/**/*.tsx"
  ]
}
